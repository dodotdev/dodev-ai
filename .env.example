# TodoMCP Configuration
# Copy this file to .env and fill in your values

# ── Convex ──────────────────────────────────────────────
# Your Convex deployment URL (from dashboard.convex.dev)
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=

# ── TodoMCP ─────────────────────────────────────────────
# Mode: "self-hosted" or "cloud"
TODOMCP_MODE=self-hosted

# Your API key (generate with: npx @todomcp/mcp-server generate-key)
TODOMCP_API_KEY=

# ── Optional: Vector Search ─────────────────────────────
# Enable semantic memory search with embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Cloud Mode Only ─────────────────────────────────────
# (Not needed for self-hosted)
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
