# DoMCP Configuration
# Copy this file to .env and fill in your values

# ── Convex ──────────────────────────────────────────────
# Your Convex deployment URL (from dashboard.convex.dev)
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=

# ── DoMCP ─────────────────────────────────────────────
# Mode: "self-hosted" or "cloud"
DOMCP_MODE=self-hosted

# Your API key (generate with: npx @domcp/mcp-server generate-key)
DOMCP_API_KEY=

# ── Optional: Vector Search ─────────────────────────────
# Enable semantic memory search with embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Web App (apps/web) ─────────────────────────────────
# Public Convex URL for Next.js client
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ── Cloud Mode Only ─────────────────────────────────────
# (Not needed for self-hosted)
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
