# Convex deployment URL
CONVEX_URL=https://your-deployment.convex.cloud

# Self-hosted mode: API key for MCP authentication
# Generate with: pnpm generate-key
DODEV_API_KEY=dodev_sk_your_key_here

# --- Cloud mode only (DODEV_MODE=cloud) ---

# Public URL of this MCP server
# Dev: http://localhost:3100  Production: https://mcp.dodev.ai
DODEV_BASE_URL=http://localhost:3100

# URL of the dodev.ai web app (handles login UI)
# Dev: http://localhost:3041  Production: https://dodev.ai
DODEV_WEB_URL=http://localhost:3041

# JWT signing secret shared between MCP server and web app (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DODEV_JWT_SECRET=

# Server port (defaults to 3100)
PORT=3100
