{
  "name": "@dodev/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "dodev.ai MCP server — AI-native task and memory management",
  "license": "MIT",
  "bin": {
    "dodev": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/skill"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/skill','dist/skill',{recursive:true})\"",
    "dev:cloud": "DODEV_MODE=cloud tsx --env-file=.env.local src/index.ts",
    "dev:stdio": "tsx --env-file=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "generate-key": "tsx src/cli.ts generate-key",
    "setup-skill": "tsx src/cli.ts setup-skill"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@dodev/shared": "workspace:*",
    "convex": "^1.31.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
