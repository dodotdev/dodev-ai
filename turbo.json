{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_DASHBOARD_ORIGIN",
        "VITE_CONVEX_URL",
        "VITE_MARKETING_ORIGIN",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "WORKOS_COOKIE_PASSWORD",
        "WORKOS_COOKIE_MAX_AGE",
        "WORKOS_REDIRECT_URI",
        "DODEV_JWT_SECRET",
        "SEND_DEV_API_KEY",
        "SEND_DEV_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:cloud": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {}
  }
}
