# Convex URL the dashboard queries against. For dev this is the shared
# dev deployment; prod builds use the prod URL via Vercel env vars.
VITE_CONVEX_URL=https://notable-gazelle-779.convex.cloud

# Origin of the marketing / auth app (dodev.ai in prod, http://localhost:3041
# in dev). Used for the cross-subdomain /api/auth/session fetch and for the
# redirect-to-sign-in flow.
VITE_MARKETING_ORIGIN=http://localhost:3041
