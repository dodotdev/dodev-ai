# Convex URL the dashboard queries against.
VITE_CONVEX_URL=https://notable-gazelle-779.convex.cloud

# Origin of the marketing / auth app. LEAVE BLANK IN DEV — the Vite dev
# server proxies /api/auth/* to http://localhost:3041 so the browser sees
# same-origin requests (WorkOS cookie flows without SameSite headaches).
# Set this in production (https://dodev.ai) so cross-subdomain fetches with
# credentials work from app.dodev.ai.
VITE_MARKETING_ORIGIN=
